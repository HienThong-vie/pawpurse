# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/pawpurse

# Supabase — JWKS endpoint used to verify access tokens (ES256)
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Supabase admin client (account deletion, mascot bootstrap) — keep server-side only
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=

# https://console.groq.com
GROQ_API_KEY=

# Production frontend origin added to the CORS allow-list (no trailing slash)
FRONTEND_URL=
