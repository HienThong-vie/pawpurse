VITE_SUPABASE_ANON_KEYS=

# EmailJS — feedback form and rating popup (optional)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_FEEDBACK_TEMPLATE_ID=
VITE_EMAILJS_RATING_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
